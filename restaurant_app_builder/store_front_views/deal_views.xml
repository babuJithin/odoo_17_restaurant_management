<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Banner element Form-->
        <record id="deal_element_form" model="ir.ui.view">
            <field name="name">deal.element</field>
            <field name="model">deal.element</field>
            <field name="arch" type="xml">
                <form string="Banner Element">
                    <header>
                    </header>
                    <sheet>
                        <h1>
                            <field name="name" class="oe_inline" string="Name"/>
                            <field name="image" nolabel="1" widget="image" class="oe_right oe_avatar"/>
                        </h1>

                        <group>
                            <group>
                                <field name="sequence" class="oe_inline"/>
                                <field name="color" class="oe_inline" placeholder="Eg: #6F2C1D"/>
                            </group>
                            <group>
                                <field name="product_ids" widget="many2many_tags" class="oe_inline"/>
                                <field name="categ_ids" class="oe_inline" />
                            </group>
                        </group>
                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>


        <!--    Skip Order Tree View-->
        <record id="deal_element_tree" model="ir.ui.view">
            <field name="name">deal.element.tree</field>
            <field name="model">deal.element</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="color"/>
                </tree>
            </field>
        </record>


        <!--        Menu Action for Quotation-->
        <record model='ir.actions.act_window' id='deal_element_act'>
            <field name="name">Deal Element</field>
            <field name="res_model">deal.element</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Create a new deal element
                </p>
            </field>
        </record>


        <!--        Menu Items-->
        <menuitem name="Deals" id="menu_deal" parent="restaurant_app_builder.base_menu_banner" sequence="1"/>

        <menuitem id="menu_deal_view" name="Elements"
                  parent="menu_deal" action="deal_element_act" sequence="1"/>


    </data>


</odoo>